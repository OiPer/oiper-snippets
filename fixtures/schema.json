{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OiPer snippets conformance fixtures",
  "type": "array",
  "minItems": 1,
  "items": {
    "$ref": "#/$defs/case"
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "config", "input", "expected"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "config": {},
        "input": {
          "type": "string"
        },
        "expected": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "value"],
              "properties": {
                "kind": {
                  "const": "output"
                },
                "value": {
                  "type": "string"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind"],
              "properties": {
                "kind": {
                  "const": "error"
                }
              }
            }
          ]
        }
      }
    }
  }
}
