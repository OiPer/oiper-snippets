{
  "name": "oiper",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "lint": "pnpm --filter @oiper/snippets exec eslint .",
    "lint:fix": "pnpm --filter @oiper/snippets exec eslint . --fix",
    "typecheck": "pnpm --filter @oiper/snippets exec tsc --noEmit",
    "typecheck:watch": "pnpm --filter @oiper/snippets exec tsc --noEmit --watch",
    "exports": "pnpm --filter @oiper/snippets exec tsx ./write-exports.ts",
    "build": "pnpm --filter @oiper/snippets exec tsdown --config ./tsdown.config.ts",
    "dev": "pnpm --filter @oiper/snippets exec tsdown --config ./tsdown.config.ts --watch",
    "start": "pnpm --filter @oiper/snippets exec tsx --watch ./src/index.ts"
  },
  "devDependencies": {
    "vitest": "^4.1.11"
  }
}
